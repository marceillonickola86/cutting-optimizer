{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "es2020"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "types": ["node"]
  },
  "include": ["app/**/*", "components/**/*"]
}